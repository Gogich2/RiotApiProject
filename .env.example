# Core runtime
RIOT_API_KEY=
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/riot_api_project
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Public URL and secure cookies
APP_FRONTEND_BASE_URL=http://localhost:8080
APP_AUTH_SECURE_COOKIE=false

# Optional account providers (disabled by default)
APP_AUTH_EMAIL_ENABLED=false
APP_AUTH_DISCORD_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# SMTP, required before email accounts are enabled
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Rate-limit-aware refresh timing
APP_REFRESH_MANUAL_COOLDOWN=120s
APP_REFRESH_SCHEDULED_MIN_AGE=6h
APP_REFRESH_SAVED_PROFILE_ACTIVE_WINDOW=14d
APP_REFRESH_SCHEDULED_BATCH_SIZE=5
APP_REFRESH_SCHEDULER_DELAY=PT15M

# Riot API client limits
RIOT_RATE_LIMIT_ENABLED=true
RIOT_RATE_LIMIT_PER_SECOND=5
RIOT_RATE_LIMIT_PER_TWO_MINUTES=85
RIOT_RATE_LIMIT_MAX_RETRIES=5
